# Names only. Put the real values in your host's environment settings, never in git.
DATABASE_URL=            # Postgres connection string (postgres://...). Empty = local SQLite (data lost on most free hosts)
ADMIN_PASSWORD=          # enables /admin when set (long random string)
SELF_URL=                # public https URL of the site, for the 10-minute keep-awake ping (not needed on Render)
KEEPALIVE_SELF_PING=1    # set 0 to turn the keep-awake ping off
TRUST_PROXY=1            # set 1 behind a reverse proxy / on hosts other than Render
PORT=8000                # most hosts set this for you
